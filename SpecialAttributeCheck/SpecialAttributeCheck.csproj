<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.CN.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>zc979</Author>
    <Name>新月岛补正检测</Name>
    <Punchline>新月岛内检测小队/周围玩家补正（2x+y）</Punchline>
    <Description>仅在蜃景幻界新月岛（新月岛南部 / 新月岛北部 / 超魔之塔）显示悬浮窗。
悬浮窗提供四个按钮：
小队检测 —— 检查小队所有成员的补正；
周围检测 —— 检查周围 20 米内最多 48 名玩家的补正；
目标检测 —— 检查当前选中玩家的补正；
清除 —— 清除当前检测结果。
补正 = 2x+y（x=辅助职业大师层数，y=所穿新月岛装备特殊修正之和，并按“力之新月魔 / 魔之新月魔”五件套规则追加套装补正）。
其余小队成员的装备通过游戏“查看装备”流程读取后计算 y。
结果按职业 / 名称 / 补正三列对齐显示，按补正值从高到低排序，行间交替底色。
设置中可选择在悬浮窗输出，或通过 /p 发送至小队频道。</Description>
    <RepoUrl>https://github.com/yimo0908/SpecialAttributeCheck</RepoUrl>
    <Tags>crescent;occult;新月岛;补正;special;attribute;detect</Tags>
    <RootNamespace>SpecialAttributeCheck</RootNamespace>
    <AssemblyName>SpecialAttributeCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\third_party\OmenTools\OmenTools.csproj" />
    <Content Include="SpecialAttributeCheck.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
